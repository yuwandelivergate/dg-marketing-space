# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...   # server-only, never expose to the browser
# Any random string, 32+ characters:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Set to true once real admin accounts exist, to disable the built-in test accounts
DISABLE_BOOTSTRAP_ACCOUNTS=false
