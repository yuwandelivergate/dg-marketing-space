{
  "name": "dg-marketing-space",
  "productName": "DG Marketing Space",
  "version": "1.0.0",
  "description": "Delivergate DG Marketing Space – desktop workspace client",
  "main": "src/main/main.js",
  "author": "Delivergate",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:offline": "electron . --offline",
    "dev": "electron . --dev",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "optionalDependencies": {
    "get-windows": "^9.2.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.delivergate.dgmarketingspace",
    "productName": "DG Marketing Space",
    "icon": "assets/icon.png",
    "files": ["src/**/*", "assets/**/*", "config.json", "package.json"],
    "asarUnpack": ["node_modules/get-windows/**", "node_modules/uiohook-napi/**"],
    "directories": { "output": "dist" },
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Used to read the active application name for activity reports."
      }
    },
    "linux": { "target": ["AppImage", "deb"], "category": "Office" }
  }
}
